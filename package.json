{
  "name": "react-easy-sort",
  "version": "1.7.0",
  "description": "A React component to sort items in lists or grids",
  "homepage": "https://ValentinH.github.io/react-easy-sort/",
  "keywords": [
    "react",
    "sort",
    "sortable",
    "sortable grid",
    "sortable list"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ValentinH/react-easy-sort"
  },
  "packageManager": "yarn@4.4.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Valentin Hervieu",
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "start": "yarn storybook",
    "version": "yarn && yarn build",
    "build": "yarn-or-npm bili && yarn-or-npm build:copy-files",
    "test": "yarn-or-npm unit && yarn-or-npm lint && yarn-or-npm lint:ts",
    "unit": "vitest run",
    "lint": "eslint --ext .ts,.tsx ./src",
    "lint:ts": "tsc --noEmit",
    "prebuild": "rimraf dist",
    "build:copy-files": "bun ./scripts/copy-build-files.js",
    "prepublishOnly": "yarn-or-npm build",
    "precommit": "lint-staged",
    "format": "prettier --write src/**/*.ts* stories/**/*.ts*",
    "npm:publish": "np --contents=dist",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o ./docs"
  },
  "peerDependencies": {
    "react": ">=16.4.0",
    "react-dom": ">=16.4.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "9.1.10",
    "@storybook/addon-links": "^9.1.10",
    "@storybook/nextjs-vite": "^9.1.10",
    "@storybook/react": "^9.1.10",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^16.9.17",
    "@types/react-dom": "^16.9.4",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "@vitest/ui": "^3.2.4",
    "all-contributors-cli": "^6.4.0",
    "autoprefixer": "^10.4.21",
    "bili": "^5.0.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "9.1.10",
    "jsdom": "^27.0.0",
    "lint-staged": "^10.4.0",
    "next": "^15.5.4",
    "np": "^10.2.0",
    "postcss": "^8.5.6",
    "prettier": "3.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.0",
    "storybook": "^9.1.10",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "yarn-or-npm": "^3.0.1"
  },
  "lint-staged": {
    "*.+(ts|tsx|js|css)": [
      "prettier --write",
      "git add"
    ]
  }
}
